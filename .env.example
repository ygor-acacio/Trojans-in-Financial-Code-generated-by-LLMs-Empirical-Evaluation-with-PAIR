
# HuggingFace Inference API token — required to call DeepSeek and Llama models
# Generate yours at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Alternative variable name (also accepted)
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# ── R1 via API externa (OpenAI-compativel) — usado pela Etapa 1 p/ o DeepSeek-R1 ──
# Sem R1_API_KEY, o R1 nao roda (HF novita e inviavel). Com a chave, o rotulo
# "deepseek-ai/DeepSeek-R1" e roteado p/ esta API.
R1_API_BASE=https://api.deepseek.com
R1_API_KEY=
R1_API_MODEL=deepseek-reasoner
